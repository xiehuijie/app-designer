{
  "extends": "../../configs/tsconfig/base.tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "target": "esnext",
    "module": "preserve",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "declaration": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
