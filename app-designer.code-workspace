{
	"folders": [
		{
			"name": "Root",
			"path": "."
		},
		{
			"name": "Configs",
			"path": "configs"
		},
		{
			"name": "Schemas",
			"path": "schemas"
		},
		{
			"name": "VS Code Extension",
			"path": "apps/vscode"
		},
		{
			"name": "Playground",
			"path": "playground"
		}
	],
	"settings": {
		"json.schemas": [
			{
				"fileMatch": [
					"appmeta.json"
				],
				"url": "./schemas/appmeta.schema.json"
			},
			{
				"fileMatch": [
					"*.type.json",
					"*.field.json",
					"*.struct.json",
					"*.model.json",
					"*.view.json",
				],
				"url": "./schemas/types/main.schema.json"
			},
			{
				"fileMatch": [
					"*.codec.json",
				],
				"url": "./schemas/types/codec.schema.json"
			}
		],
		"yaml.schemas": {
			"./schemas/appmeta.schema.json": [
				"appmeta.yaml"
			],
			"./schemas/types/main.schema.json": [
				"*.type.yaml",
				"*.field.yaml",
				"*.struct.yaml",
				"*.model.yaml",
				"*.view.yaml",
			],
			"./schemas/types/codec.schema.json": [
				"*.codec.yaml",
			]
		},
		"material-icon-theme.folders.associations": {
			"apps/webui": "public",
			"generators/openapi": "meta",
			"generators/zod": "zeabur"
		},
		"cSpell.words": [
			"webui"
		]
	},
	"extensions": {
		"recommendations": [
			"PKief.material-icon-theme",
			"streetsidesoftware.code-spell-checker"
		]
	}
}